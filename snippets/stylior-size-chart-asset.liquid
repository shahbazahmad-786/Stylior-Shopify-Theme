{%- doc -%}
  Outputs the Stylior size-chart image for a product, or nothing if none is set.

  Matching order:
  1. Block/section override image
  2. Product metafield custom.size_chart (image)
  3. Theme settings product dropdown + chart pairs
  4. Single uploaded theme-settings chart (when only one is set)
  5. Fallback theme-settings chart

  @param {object} product - Product object
  @param {object} [override_image] - Optional image from the section/block picker
  @param {string} [class] - CSS class for the image
  @param {string} [alt] - Image alt text

  @example
  {% render 'stylior-size-chart-asset', product: product %}
{%- enddoc -%}

{%- liquid
  assign chart_image = override_image

  if chart_image == blank and product.metafields.custom.size_chart != blank
    assign chart_image = product.metafields.custom.size_chart.value | default: product.metafields.custom.size_chart
  endif

  if chart_image == blank and product != blank
    assign filled_images = 0

    for i in (1..20)
      assign mapped_image = ''
      assign mapped_product = ''
      assign mapped_url = ''

      case i
      when 1
        assign mapped_product = settings.size_chart_product_1
        assign mapped_image = settings.size_chart_image_1
      when 2
        assign mapped_url = settings.size_chart_product_2
        assign mapped_image = settings.size_chart_image_2
      when 3
        assign mapped_url = settings.size_chart_product_3
        assign mapped_image = settings.size_chart_image_3
      when 4
        assign mapped_url = settings.size_chart_product_4
        assign mapped_image = settings.size_chart_image_4
      when 5
        assign mapped_url = settings.size_chart_product_5
        assign mapped_image = settings.size_chart_image_5
      when 6
        assign mapped_url = settings.size_chart_product_6
        assign mapped_image = settings.size_chart_image_6
      when 7
        assign mapped_url = settings.size_chart_product_7
        assign mapped_image = settings.size_chart_image_7
      when 8
        assign mapped_url = settings.size_chart_product_8
        assign mapped_image = settings.size_chart_image_8
      when 9
        assign mapped_url = settings.size_chart_product_9
        assign mapped_image = settings.size_chart_image_9
      when 10
        assign mapped_url = settings.size_chart_product_10
        assign mapped_image = settings.size_chart_image_10
      when 11
        assign mapped_url = settings.size_chart_product_11
        assign mapped_image = settings.size_chart_image_11
      when 12
        assign mapped_url = settings.size_chart_product_12
        assign mapped_image = settings.size_chart_image_12
      when 13
        assign mapped_url = settings.size_chart_product_13
        assign mapped_image = settings.size_chart_image_13
      when 14
        assign mapped_url = settings.size_chart_product_14
        assign mapped_image = settings.size_chart_image_14
      when 15
        assign mapped_url = settings.size_chart_product_15
        assign mapped_image = settings.size_chart_image_15
      when 16
        assign mapped_url = settings.size_chart_product_16
        assign mapped_image = settings.size_chart_image_16
      when 17
        assign mapped_url = settings.size_chart_product_17
        assign mapped_image = settings.size_chart_image_17
      when 18
        assign mapped_url = settings.size_chart_product_18
        assign mapped_image = settings.size_chart_image_18
      when 19
        assign mapped_url = settings.size_chart_product_19
        assign mapped_image = settings.size_chart_image_19
      when 20
        assign mapped_url = settings.size_chart_product_20
        assign mapped_image = settings.size_chart_image_20
      endcase

      if mapped_image == blank
        continue
      endif

      assign filled_images = filled_images | plus: 1
      assign only_mapped_image = mapped_image
      assign slot_matched = false

      if mapped_product != blank
        if mapped_product.id == product.id or mapped_product.handle == product.handle
          assign slot_matched = true
        endif
      elsif mapped_url != blank
        assign mapped_handle = mapped_url | split: '/products/' | last | split: '?' | first | split: '/' | first
        if mapped_url contains 'shopify://products/'
          assign mapped_handle = mapped_url | remove: 'shopify://products/' | split: '?' | first | split: '/' | first
        endif
        if mapped_handle == product.handle or product.url == mapped_url
          assign slot_matched = true
        endif
      endif

      if slot_matched
        assign chart_image = mapped_image
        break
      endif
    endfor

    if chart_image == blank and filled_images == 1
      assign chart_image = only_mapped_image
    endif
  endif

  if chart_image == blank
    assign chart_image = settings.size_chart_default
  endif

  assign image_class = class | default: 'stylior-size-chart__img'
  assign image_alt = alt | default: 'Size chart'
-%}

{%- if chart_image != blank -%}
  {{
    chart_image
    | image_url: width: 1400
    | image_tag:
      class: image_class,
      loading: 'lazy',
      widths: '600, 900, 1200, 1400',
      sizes: '(min-width: 750px) 640px, 92vw',
      alt: image_alt
  }}
{%- endif -%}
