{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign chart_alt = block.settings.heading | default: 'Size chart'
  if product != blank
    assign chart_alt = chart_alt | append: ' — ' | append: product.title
  endif
  assign modal_id = 'stylior-size-chart-' | append: block.id
%}

{% capture chart_img_html %}{% render 'stylior-size-chart-asset', product: product, override_image: block.settings.image, class: 'stylior-size-chart__img', alt: chart_alt %}{% endcapture %}
{% assign chart_img_html = chart_img_html | strip %}

{% if product != blank and chart_img_html != blank %}
  <div
    class="stylior-size-chart stylior-size-chart--block"
    id="{{ modal_id }}-wrap"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="stylior-size-chart__trigger"
      aria-haspopup="dialog"
      aria-controls="{{ modal_id }}"
      data-stylior-size-open="{{ modal_id }}"
    >
      <span class="stylior-size-chart__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 7h18v10H3V7zm3 0v3m3-3v2m3-2v3m3-3v2m3-2v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      {{ block.settings.button_label }}
    </button>

    <div
      class="stylior-size-chart__dialog"
      id="{{ modal_id }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ modal_id }}-title"
      hidden
    >
      <div class="stylior-size-chart__backdrop" data-stylior-size-close tabindex="-1"></div>
      <div class="stylior-size-chart__panel">
        <div class="stylior-size-chart__header">
          <h2 class="stylior-size-chart__title" id="{{ modal_id }}-title">
            {{ block.settings.heading | default: 'Size chart' }}
          </h2>
          <button
            type="button"
            class="stylior-size-chart__close"
            data-stylior-size-close
            aria-label="Close size chart"
          >
            &times;
          </button>
        </div>
        <div class="stylior-size-chart__body">
          {{ chart_img_html }}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('{{ modal_id }}-wrap');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      var dialog = document.getElementById('{{ modal_id }}');
      var openBtn = root.querySelector('[data-stylior-size-open]');

      function openDialog() {
        if (!dialog) return;
        dialog.hidden = false;
        document.documentElement.classList.add('stylior-size-chart-open');
        var closeBtn = dialog.querySelector('.stylior-size-chart__close');
        if (closeBtn) closeBtn.focus();
      }

      function closeDialog() {
        if (!dialog) return;
        dialog.hidden = true;
        document.documentElement.classList.remove('stylior-size-chart-open');
        if (openBtn) openBtn.focus();
      }

      if (openBtn) openBtn.addEventListener('click', openDialog);
      root.querySelectorAll('[data-stylior-size-close]').forEach(function (el) {
        el.addEventListener('click', closeDialog);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dialog && !dialog.hidden) closeDialog();
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Stylior size chart",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Product size charts Theme settings → Size charts mein upload hote hain. Yahan sirf is page ka optional override hai."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Size chart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Modal heading",
      "default": "Size chart"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom chart image",
      "info": "Optional. Overrides Theme settings > Size charts for this block."
    }
  ],
  "presets": [
    {
      "name": "Stylior size chart",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
