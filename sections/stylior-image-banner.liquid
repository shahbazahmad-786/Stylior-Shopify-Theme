{% comment %}
  Full-width brand banner using an image uploaded in the theme editor
{% endcomment %}

<section class="stylior-banner" id="stylior-banner-{{ section.id }}">
  {% if section.settings.link != blank %}
    <a class="stylior-banner__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.heading | default: shop.name | escape }}">
  {% else %}
    <div class="stylior-banner__link">
  {% endif %}

  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag:
        class: 'stylior-banner__img',
        loading: 'lazy',
        widths: '600, 900, 1200, 1600, 2000',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.heading
    }}
  {% else %}
    <div class="stylior-banner__placeholder" aria-hidden="true"></div>
  {% endif %}

  {% if section.settings.heading != blank or section.settings.script_text != blank %}
    <div class="stylior-banner__overlay">
      {% if section.settings.heading != blank %}
        <h2 class="stylior-banner__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.script_text != blank %}
        <span class="stylior-banner__script">{{ section.settings.script_text }}</span>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Stylior image banner",
  "tag": "section",
  "class": "section-stylior-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Script overlay"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Stylior image banner"
    }
  ]
}
{% endschema %}
