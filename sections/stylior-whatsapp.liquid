{% if section.settings.phone != blank %}
  {% liquid
    assign phone_clean = section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', ''
  %}
  <a
    class="stylior-whatsapp"
    href="https://wa.me/{{ phone_clean }}{% if section.settings.message != blank %}?text={{ section.settings.message | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16.04 4C9.4 4 4 9.28 4 15.76c0 2.08.56 4.1 1.62 5.88L4 28l6.56-1.7a12.2 12.2 0 0 0 5.48 1.32h.01c6.64 0 12.04-5.28 12.04-11.76C28.09 9.28 22.68 4 16.04 4zm6.98 16.72c-.3.84-1.74 1.54-2.42 1.64-.62.08-1.4.12-2.26-.14-.52-.16-1.18-.38-2.02-.74-3.56-1.54-5.88-5.12-6.06-5.36-.18-.24-1.46-1.94-1.46-3.7s.92-2.62 1.26-2.98c.34-.36.74-.44 1-.44h.72c.22 0 .52-.08.82.62.3.72 1.04 2.52 1.12 2.7.08.18.14.4.02.64-.12.24-.18.4-.36.62-.18.22-.38.48-.54.64-.18.18-.36.38-.16.74.2.36.9 1.48 1.94 2.4 1.34 1.18 2.46 1.56 2.82 1.74.36.18.56.14.78-.08.22-.22.92-1.06 1.16-1.42.24-.36.48-.3.8-.18.32.12 2.04.96 2.38 1.14.34.18.56.26.64.4.08.16.08.9-.22 1.74z"/>
    </svg>
  </a>
{% endif %}

{% schema %}
{
  "name": "Stylior WhatsApp",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "WhatsApp number (with country code)",
      "default": "923241178086",
      "info": "Digits only, e.g. 923241178086"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Prefill message",
      "default": "Hey Stylior! Looking at the new drop — can you help?"
    }
  ],
  "presets": [
    {
      "name": "Stylior WhatsApp"
    }
  ]
}
{% endschema %}
