{% comment %}
  Professional Stylior footer — newsletter first, brand, links, contact, bottom bar
{% endcomment %}

<footer class="stylior-pro-footer" id="stylior-pro-footer-{{ section.id }}">
  {% if section.settings.show_newsletter %}
    <div class="stylior-pro-footer__subscribe">
      <div class="stylior-pro-footer__subscribe-inner">
        <div class="stylior-pro-footer__subscribe-copy">
          <p class="stylior-pro-footer__subscribe-eyebrow">Newsletter</p>
          <h2 class="stylior-pro-footer__subscribe-title">{{ section.settings.news_heading }}</h2>
          {% if section.settings.news_text != blank %}
            <p class="stylior-pro-footer__subscribe-text">{{ section.settings.news_text }}</p>
          {% endif %}
        </div>
        {% form 'customer', class: 'stylior-pro-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="ProFooterEmail-{{ section.id }}">Email</label>
          <div class="stylior-pro-footer__form-row">
            <input
              id="ProFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.news_placeholder }}"
              required
              autocomplete="email"
            >
            <button type="submit">{{ section.settings.news_button }}</button>
          </div>
          {% if form.posted_successfully? %}
            <p class="stylior-pro-footer__form-msg stylior-pro-footer__form-msg--success" role="status">
              Thanks — you're subscribed.
            </p>
          {% endif %}
          {% if form.errors %}
            <p class="stylior-pro-footer__form-msg stylior-pro-footer__form-msg--error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  {% endif %}

  <div class="stylior-pro-footer__inner">
    <div class="stylior-pro-footer__grid">
      <div class="stylior-pro-footer__brand">
        <a class="stylior-pro-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 280
              | image_tag:
                loading: 'lazy',
                widths: '140, 200, 280',
                class: 'stylior-pro-footer__logo-img',
                alt: shop.name
            }}
          {% elsif settings.logo_inverse != blank %}
            {{
              settings.logo_inverse
              | image_url: width: 280
              | image_tag:
                loading: 'lazy',
                widths: '140, 200, 280',
                class: 'stylior-pro-footer__logo-img',
                alt: shop.name
            }}
          {% elsif settings.logo != blank %}
            {{
              settings.logo
              | image_url: width: 280
              | image_tag:
                loading: 'lazy',
                widths: '140, 200, 280',
                class: 'stylior-pro-footer__logo-img stylior-pro-footer__logo-img--invert',
                alt: shop.name
            }}
          {% else %}
            <span class="stylior-pro-footer__logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>
        {% if section.settings.tagline != blank %}
          <p class="stylior-pro-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
        <div class="stylior-pro-footer__social">
          {% if section.settings.instagram != blank %}
            <a
              class="stylior-pro-footer__social-link"
              href="{{ section.settings.instagram }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2Zm0 7.92a3.12 3.12 0 1 1 0-6.24 3.12 3.12 0 0 1 0 6.24Zm6.3-8.16a1.12 1.12 0 1 1-2.24 0 1.12 1.12 0 0 1 2.24 0ZM12 2.4c-2.46 0-2.77.01-3.74.05-2.5.12-3.7 1.3-3.82 3.82-.04.97-.05 1.28-.05 3.74s.01 2.77.05 3.74c.12 2.51 1.31 3.7 3.82 3.82.97.04 1.28.05 3.74.05s2.77-.01 3.74-.05c2.52-.12 3.7-1.31 3.82-3.82.04-.97.05-1.28.05-3.74s-.01-2.77-.05-3.74c-.12-2.51-1.31-3.7-3.82-3.82C14.77 2.41 14.46 2.4 12 2.4Zm0 1.68c2.42 0 2.7.01 3.65.05 1.78.08 2.61.9 2.69 2.69.04.95.05 1.23.05 3.65s-.01 2.7-.05 3.65c-.08 1.78-.91 2.61-2.69 2.69-.95.04-1.23.05-3.65.05s-2.7-.01-3.65-.05c-1.79-.08-2.61-.91-2.69-2.69-.04-.95-.05-1.23-.05-3.65s.01-2.7.05-3.65c.08-1.78.91-2.61 2.69-2.69.95-.04 1.23-.05 3.65-.05Z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook != blank %}
            <a
              class="stylior-pro-footer__social-link"
              href="{{ section.settings.facebook }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M14.5 8.25h2.25V5.1A29 29 0 0 0 13.47 5C10.9 5 9.14 6.62 9.14 9.55v1.7H6.5v3.5h2.64V22h3.53v-7.25h2.96l.47-3.5h-3.43V9.9c0-1.01.28-1.65 1.83-1.65Z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok != blank %}
            <a
              class="stylior-pro-footer__social-link"
              href="{{ section.settings.tiktok }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19.6 8.7a6.7 6.7 0 0 1-3.9-1.25v7.08a5.73 5.73 0 1 1-4.93-5.67v2.52a3.25 3.25 0 1 0 2.28 3.1V2.5h2.45a4.27 4.27 0 0 0 4.1 4.05v2.15Z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="stylior-pro-footer__col">
        <h3 class="stylior-pro-footer__heading">{{ section.settings.shop_heading }}</h3>
        <ul class="stylior-pro-footer__links">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          <li><a href="{{ routes.collections_url }}">All collections</a></li>
          {% for collection in collections %}
            {% if collection.handle != 'all'
              and collection.handle != 'frontpage'
              and collection.handle != 'search'
              and collection.all_products_count > 0
            %}
              <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
            {% endif %}
          {% endfor %}
          {% if section.settings.shop_menu != blank %}
            {% for link in section.settings.shop_menu.links %}
              {% unless link.title == 'Search' or link.url == routes.search_url %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endunless %}
            {% endfor %}
          {% endif %}
          <li><a href="{{ routes.cart_url }}">Cart</a></li>
        </ul>
      </div>

      <div class="stylior-pro-footer__col">
        <h3 class="stylior-pro-footer__heading">{{ section.settings.explore_heading }}</h3>
        <ul class="stylior-pro-footer__links">
          <li><a href="{{ routes.account_login_url }}">Login</a></li>
          <li><a href="{{ routes.account_url }}">Account</a></li>
          <li><a href="{{ routes.account_register_url }}">Create account</a></li>
          {% if pages.contact != blank %}
            <li><a href="{{ pages.contact.url }}">Contact</a></li>
          {% else %}
            <li><a href="/pages/contact">Contact</a></li>
          {% endif %}
          {% if pages['about'] != blank %}
            <li><a href="{{ pages['about'].url }}">About</a></li>
          {% elsif pages['about-us'] != blank %}
            <li><a href="{{ pages['about-us'].url }}">About us</a></li>
          {% endif %}
          {% if pages['faq'] != blank %}
            <li><a href="{{ pages.faq.url }}">FAQ</a></li>
          {% elsif pages['faqs'] != blank %}
            <li><a href="{{ pages.faqs.url }}">FAQs</a></li>
          {% endif %}
          {% if pages['shipping-policy'] != blank %}
            <li><a href="{{ pages['shipping-policy'].url }}">Shipping</a></li>
          {% endif %}
          {% if pages['size-guide'] != blank %}
            <li><a href="{{ pages['size-guide'].url }}">Size guide</a></li>
          {% endif %}
          {% for page in pages %}
            {% assign page_handle = page.handle %}
            {% if page_handle != 'contact'
              and page_handle != 'about'
              and page_handle != 'about-us'
              and page_handle != 'faq'
              and page_handle != 'faqs'
              and page_handle != 'shipping-policy'
              and page_handle != 'size-guide'
              and page_handle != 'search'
            %}
              <li><a href="{{ page.url }}">{{ page.title }}</a></li>
            {% endif %}
          {% endfor %}
          {% for blog in blogs %}
            <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
          {% endfor %}
          {% if section.settings.explore_menu != blank %}
            {% for link in section.settings.explore_menu.links %}
              {% unless link.title == 'Search' or link.url == routes.search_url %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endunless %}
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="stylior-pro-footer__col stylior-pro-footer__col--contact">
        <h3 class="stylior-pro-footer__heading">{{ section.settings.contact_heading }}</h3>
        <ul class="stylior-pro-footer__contact">
          {% if section.settings.phone != blank %}
            <li>
              <span>Phone</span>
              <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
            </li>
          {% endif %}
          {% if section.settings.email != blank %}
            <li>
              <span>Email</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {% endif %}
          {% if section.settings.address != blank %}
            <li>
              <span>Studio</span>
              <p>{{ section.settings.address }}</p>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="stylior-pro-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="stylior-pro-footer__policies">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Stylior pro footer",
  "tag": "section",
  "class": "section-stylior-pro-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Premium clothing from Multan — crafted for everyday style."
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop column heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Extra shop links (optional)"
    },
    {
      "type": "text",
      "id": "explore_heading",
      "label": "Explore column heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "explore_menu",
      "label": "Extra explore links (optional)"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+92 324 1178086"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "stylior.pk@gmail.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Gulgasht Colony, Multan, Punjab, Pakistan"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "news_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Newsletter text",
      "default": "Get updates on new arrivals and offers via email."
    },
    {
      "type": "text",
      "id": "news_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "news_button",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Stylior pro footer"
    }
  ]
}
{% endschema %}
