{% comment %}
  Stylior hero — plain full-bleed video only
{% endcomment %}

<section
  class="stylior-hero stylior-hero--plain"
  id="stylior-hero-{{ section.id }}"
  {% if section.settings.min_height != blank %}
    style="--stylior-hero-min-height: {{ section.settings.min_height }}vh;"
  {% endif %}
>
  <div class="stylior-hero__media">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          class: 'stylior-hero__video',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          image_size: '1920x'
      }}
    {% else %}
      <div class="stylior-hero__placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Stylior hero video",
  "tag": "section",
  "class": "section-stylior-hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Upload the video in Theme settings or Content > Files, then select it here."
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum height",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "Stylior hero video"
    }
  ]
}
{% endschema %}
